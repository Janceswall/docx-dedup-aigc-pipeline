# 统一换行为 LF，避免 Windows / macOS / Linux 之间产生无意义的整文件 diff
* text=auto eol=lf

# 文本文件
*.py     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf

# 二进制文件：不做任何换行转换
*.docx   binary
*.doc    binary
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.zip    binary
